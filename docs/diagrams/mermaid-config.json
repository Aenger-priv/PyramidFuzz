    "textColor": "#182b43",
    "mainBkg": "#fff5dc",
    "clusterBkg": "#fcfcfd",
    "clusterBorder": "#aab6c4",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#edf2f8",
    "actorBorder": "#536880",
    "actorTextColor": "#182b43",
    "actorLineColor": "#aab6c4",
    "signalColor": "#334b67",
    "signalTextColor": "#182b43",
    "noteBkgColor": "#fff5dc",
    "noteBorderColor": "#c8ac70",
    "noteTextColor": "#493612",
    "activationBkgColor": "#eaf5f1",
    "activationBorderColor": "#397c68",
